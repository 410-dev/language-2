// Code snippets taken from SPEC.md (completed where the spec elides parts).
@using sdk 1
@runtime compiler interpreter bytecode
@compiler(
    IncludeDependencies=false
    Target=[i386, amd64, arm64]
    EnableSoftwareEmulation=false
    MemoryManagement=ownership
)
@runtimecfg(
    IntegerOverflow=error
)

using stdio as stdio

public interface Entity {
    public function Int64 hello()
}

public interface MovingEntity extends Entity {
    public function void move(Int64 dx, Int64 dy)

    public default function Boolean canMove() {
        return true
    }
}

public class Animal {
    protected String species
    public Animal(String species) { this.species = species }
}

public class Human extends Animal implements Entity, MovingEntity {

    public  static              Immutable String id = "animal.mammal.Human"
    private setter.chain getter           String name
    private setter.chain getter           Int64 age
    private              getter Immutable Int64 socialSecurity
    private                     Immutable String race
    private setter.nochain                String? eyeColor

    public Human(String name, Int64 age, Int64 socialSecurity) {
        super(name.clone())
        this.name = name
        this.age = age
        this.socialSecurity = socialSecurity
        this.race = "Someone"
    }

    @Override
    public function Int64 hello() { return 1 }

    @Override
    public function void move(Int64 dx, Int64 dy) {}

    @Override
    public function Boolean equals(&Human other) {
        return this.socialSecurity == other.socialSecurity()
    }

    public function &String raceName() { return &this.race }
}

function (Int|Float, Int|String, Boolean?) myFunc(String[] args) {
    return 1, "two", true
}

function void greet(&String name) { stdio.println(name) }
function void shout(*String name) { name.append("!") }
function void addOne(*Int64 count) { count += 1 }

function String longer(&String a, &String b) {
    return a.length() > b.length() ? a.clone() : b.clone()
}

function T identity[T](T x) {
    return x
}

function Int64 add(Int64 a, Int64 b) {
    return a + b
}

function void log(String msg) {
    stdio.println(msg)
}

function void main(String[] args) {
    // 4.5 arrays
    Int64[] arr = Int64.array(length = 10, length_immutable = true)
    Int64[] arr2 = Int64.array()
    stdio.println(arr.length() + arr2.length())

    // 4.6 dictionaries
    Dictionary[String, String|Int64|Dictionary[String, DTVariable]] d = {
        "a": "b",
        "n": 1,
        "d": {"x": "y"}
    }
    Dictionary loose = {"a": 1, "b": "text"}
    stdio.println(d)
    stdio.println(loose)

    // 4.9 dynamic / inferred
    STVariable x = 1
    DTVariable z = 1
    z = "text"
    stdio.println(f"{x} {z}")

    // 4.10 / 8.5 function types and lambdas
    Function[(Int32, Float32), void] f = (Int32 a, Float32 b) -> {
        stdio.println(f"a={a}, b={b}")
    }
    f.run(1, 3.0)

    // 4.11 conversions
    Int64 big = 100
    Int8 small = big.castTo(Int8)
    stdio.println(small)

    // 4.12 generics
    stdio.println(identity[Int64](5))
    stdio.println(identity(5))

    // 5.1 declarations
    Int64 a = 1
    Immutable String sid = "x"
    copied String s = "abcd"
    String t = s
    stdio.println(f"{a} {sid} {s} {t}")

    // 6.x operators
    Int v = a == 10 ? 1 : 2
    String? input = null
    String nm = input ?? "anonymous"
    stdio.println(f"{v} {nm} {-2 ** 2} {2 ** 3 ** 2}")
    v1, v2, v3 = myFunc(args.clone())!
    v4, _, v6 = myFunc(args.clone())!
    stdio.println(f"{v1} {v2} {v3} {v4} {v6}")

    // 7.3 switch
    String value = "xylophone"
    String xx = "xy"
    switch (value as w) {
        case w == "1":
            stdio.println("one")
        case w.startsWith(xx):
            stdio.println("starts with xy")
            fallthrough
        default:
            stdio.println("default")
    }

    // 7.4 loops
    for (Int counter = 0; counter < 2; counter += 1) {}
    for (element in arr) {}
    for (element in Int.range(0, 10, 5)) {
        stdio.println(element)
    }
    for (index, element in arr.kv()) {}

    // 8.1
    stdio.println(add(2, 3))
    log("logged")

    // 9.2 ownership
    String h = "hello"
    String hb = h
    String hc = hb.clone()
    stdio.println(hc)

    // 9.3 references
    String n = "Alice"
    greet(&n)
    shout(*n)
    stdio.println(n)
    Int64 cnt = 0
    addOne(*cnt)
    stdio.println(cnt)
    stdio.println(longer(&n, &hc))

    // 10.6 accessors
    Human alice = Human("Alice", 30, 123)
    alice.name("Alice").age(31)
    Int64 age = alice.age()
    &String an = alice.name()
    String owned = alice.name().clone()
    stdio.println(f"{age} {an} {owned} {Human.id} {alice.raceName()}")
    stdio.println(alice == Human("Bob", 1, 123))

    // 11.1 formatting
    String name = "Bob"
    Float64 xLocation = 1.5
    Int64 count = 4
    stdio.println(f"my name is {name}, x={xLocation.format(-1, 3)}")
    stdio.println("Hello %str%, you have %number% messages".format(name, count))

    // 13.2 indexing
    Int64 first = arr[0]
    arr[-1] = 5
    stdio.println(f"{first} {arr.last()} {arr.at(-1)} {arr.last(1)}")
}
