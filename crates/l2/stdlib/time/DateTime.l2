@using sdk 1

// time.DateTime: a calendar date and time with millisecond precision (spec 14.7). The proleptic
// Gregorian calendar is used for all years.
//
// A DateTime is either in an IANA time zone ("Asia/Seoul", "America/New_York"), whose rules
// give the UTC offset at every instant (daylight saving time included), or at a fixed UTC
// offset (ofOffset, withOffset, toUtc, parsed text with an offset). now() and of() use the
// system's local zone.
//
// Formatting and parsing patterns: yyyy yy MMMM (January) MMM (Jan) MM M dd d HH H hh h mm m
// ss s SSS a (AM/PM) EEEE (Monday) EEE (Mon) XXX (+09:00, Z for UTC) xxx (+00:00) Z (+0900)
// VV (zone ID, e.g. Asia/Seoul) zzz (abbreviation, e.g. KST, EDT); text in single quotes is
// literal ('T'), '' is a quote.

using intrinsics as intr

public class DateTime {
    // milliseconds since 1970-01-01T00:00:00Z
    private Immutable Int64 millis
    // seconds east of UTC
    private Immutable Int64 offset
    // IANA zone; null for a fixed offset
    private Immutable String? zoneName

    private DateTime(Int64 epochMillis, Int64 offsetSeconds, String? zone) {
        this.millis = epochMillis
        this.offset = offsetSeconds
        this.zoneName = zone
    }

    // the instant `m` in `zone` (null: the local zone)
    private static function DateTime at(Int64 m, String? zone) {
        String? z = zone == null ? intr.tzLocalName() : zone
        return new DateTime(m, intr.tzOffset(z, m), z)
    }

    // a wall-clock time in `zone` (null: the local zone)
    private static function DateTime wall(&Int64[] fields, String? zone) {
        String? z = zone == null ? intr.tzLocalName() : zone
        m, off = intr.tzOffsetOf(z, fields)
        return new DateTime(m, off, z)
    }

    private static function String checkZone(&String zone) {
        if (!intr.tzValid(zone)) {
            throw IllegalArgumentException(f"unknown time zone \"{zone}\" (use an IANA name such as \"Asia/Seoul\" or \"UTC\")")
        }
        return zone.clone()
    }

    // ------------------------------------------------------------------ creation
    // the current date and time in the local zone
    public static function DateTime now() {
        return DateTime.at(intr.timeNowMillis(), null)
    }

    // the current date and time in `zone`
    public static function DateTime now(&String zone) {
        return DateTime.at(intr.timeNowMillis(), DateTime.checkZone(zone))
    }

    public static function DateTime utcNow() {
        return new DateTime(intr.timeNowMillis(), 0, null)
    }

    // a date and time in the local zone
    public static function DateTime of(Int64 year, Int64 month, Int64 day, Int64 hour, Int64 minute, Int64 second) {
        return DateTime.wall([year, month, day, hour, minute, second, 0], null)
    }

    public static function DateTime of(Int64 year, Int64 month, Int64 day) {
        return DateTime.wall([year, month, day, 0, 0, 0, 0], null)
    }

    public static function DateTime of(Int64 year, Int64 month, Int64 day, Int64 hour, Int64 minute, Int64 second, Int64 millisecond) {
        return DateTime.wall([year, month, day, hour, minute, second, millisecond], null)
    }

    // a date and time in `zone`; a time skipped by a daylight saving change moves forward
    // (02:30 becomes 03:30), a time that occurs twice takes the earlier offset
    public static function DateTime ofZone(Int64 year, Int64 month, Int64 day, Int64 hour, Int64 minute, Int64 second, &String zone) {
        return DateTime.wall([year, month, day, hour, minute, second, 0], DateTime.checkZone(zone))
    }

    public static function DateTime ofZone(Int64 year, Int64 month, Int64 day, &String zone) {
        return DateTime.wall([year, month, day, 0, 0, 0, 0], DateTime.checkZone(zone))
    }

    // a date and time at a fixed offset from UTC (in seconds; 0 = UTC)
    public static function DateTime ofOffset(Int64 year, Int64 month, Int64 day, Int64 hour, Int64 minute, Int64 second, Int64 offsetSeconds) {
        Int64[] f = [year, month, day, hour, minute, second, 0]
        return new DateTime(intr.timeFromFields(f, offsetSeconds), offsetSeconds, null)
    }

    // the instant in the local zone
    public static function DateTime ofEpochMillis(Int64 epochMillis) {
        return DateTime.at(epochMillis, null)
    }

    public static function DateTime ofEpochMillis(Int64 epochMillis, Int64 offsetSeconds) {
        return new DateTime(epochMillis, offsetSeconds, null)
    }

    public static function DateTime ofEpochMillis(Int64 epochMillis, &String zone) {
        return DateTime.at(epochMillis, DateTime.checkZone(zone))
    }

    // Parses `text` with `pattern`; text without an offset or zone (XXX, VV) is local time.
    public static function DateTime parse(&String text, &String pattern) {
        r, z = intr.timeParse(text, pattern, intr.tzLocalName())
        return new DateTime(r[0], r[1], z)
    }

    // text without an offset or zone is a time in `zone`
    public static function DateTime parse(&String text, &String pattern, &String zone) {
        r, z = intr.timeParse(text, pattern, DateTime.checkZone(zone))
        return new DateTime(r[0], r[1], z)
    }

    // ISO-8601: 2026-10-07T12:30:00, 2026-10-07T12:30:00.250+09:00, 2026-10-07T03:30:00Z,
    // 2026-10-07, and with a zone: 2026-10-07T12:30:00+09:00[Asia/Seoul]
    public static function DateTime parse(&String text) {
        String[] patterns = [
            "yyyy-MM-dd'T'HH:mm:ss.SSSXXX'['VV']'", "yyyy-MM-dd'T'HH:mm:ssXXX'['VV']'", "yyyy-MM-dd'T'HH:mm:ss.SSSXXX", "yyyy-MM-dd'T'HH:mm:ssXXX",
            "yyyy-MM-dd'T'HH:mm:ss.SSS", "yyyy-MM-dd'T'HH:mm:ss", "yyyy-MM-dd'T'HH:mm", "yyyy-MM-dd"
        ]
        for (p in patterns) {
            try {
                return DateTime.parse(text, p)
            } catch (IllegalArgumentException e) {
            }
        }
        throw IllegalArgumentException(f"cannot parse \"{text}\" as an ISO-8601 date and time")
    }

    // ------------------------------------------------------------------ fields
    private function Int64 field(Int64 i) {
        Int64[] f = intr.timeFields(millis, offset)
        return f[i]
    }

    public function Int64 year() {
        return field(0)
    }

    // 1..12
    public function Int64 month() {
        return field(1)
    }

    public function Int64 day() {
        return field(2)
    }

    public function Int64 hour() {
        return field(3)
    }

    public function Int64 minute() {
        return field(4)
    }

    public function Int64 second() {
        return field(5)
    }

    public function Int64 millisecond() {
        return field(6)
    }

    // 1 = Monday ... 7 = Sunday
    public function Int64 dayOfWeek() {
        return field(7)
    }

    public function Int64 dayOfYear() {
        return field(8)
    }

    public function Int64 epochMillis() {
        return millis
    }

    public function Int64 offsetSeconds() {
        return offset
    }

    // the IANA zone, or null at a fixed offset
    public function String? zone() {
        return zoneName == null ? null : zoneName!.clone()
    }

    // the zone's abbreviation at this instant (KST, EDT, ...), or the offset as UTC+hh:mm
    public function String zoneAbbreviation() {
        return intr.timeFormat(millis, offset, "zzz", zoneName)
    }

    // ------------------------------------------------------------------ arithmetic
    // exact time: in a zone the wall clock may jump at daylight saving changes
    public function DateTime plus(&Duration d) {
        Int64 m = millis + d.toMillis()
        return zoneName == null ? new DateTime(m, offset, null) : DateTime.at(m, zone())
    }

    public function DateTime minus(&Duration d) {
        Int64 m = millis - d.toMillis()
        return zoneName == null ? new DateTime(m, offset, null) : DateTime.at(m, zone())
    }

    public function DateTime operator+(&Duration d) {
        return plus(d)
    }

    public function DateTime operator-(&Duration d) {
        return minus(d)
    }

    public function Duration operator-(&DateTime earlier) {
        return Duration.ofMillis(millis - earlier.millis)
    }

    // calendar days: the same wall-clock time on another date (in a zone it may be 23 or 25
    // hours later across a daylight saving change)
    public function DateTime plusDays(Int64 days) {
        m, off = intr.timeAddCalendar(millis, offset, 0, days, zoneName)
        return new DateTime(m, off, zone())
    }

    // calendar months; the day is clamped to the month's length (Jan 31 + 1 month = Feb 28/29)
    public function DateTime plusMonths(Int64 months) {
        m, off = intr.timeAddCalendar(millis, offset, months, 0, zoneName)
        return new DateTime(m, off, zone())
    }

    public function DateTime plusYears(Int64 years) {
        return plusMonths(years * 12)
    }

    // the same instant in another zone
    public function DateTime inZone(&String zone) {
        return DateTime.at(millis, DateTime.checkZone(zone))
    }

    // the same instant at a fixed offset
    public function DateTime withOffset(Int64 offsetSeconds) {
        return new DateTime(millis, offsetSeconds, null)
    }

    public function DateTime toUtc() {
        return new DateTime(millis, 0, null)
    }

    public function DateTime toLocal() {
        return DateTime.at(millis, null)
    }

    public function Boolean isBefore(&DateTime other) {
        return millis < other.millis
    }

    public function Boolean isAfter(&DateTime other) {
        return millis > other.millis
    }

    public function Int32 compareTo(&DateTime other) {
        return millis.compareTo(other.millis)
    }

    // the same instant (whatever the zones or offsets)
    public function Boolean equals(&DateTime other) {
        return millis == other.millis
    }

    // ------------------------------------------------------------------ text
    public function String format(&String pattern) {
        return intr.timeFormat(millis, offset, pattern, zoneName)
    }

    // ISO-8601 with milliseconds and offset, then the zone in brackets
    public function String toString() {
        String s = intr.timeFormat(millis, offset, "yyyy-MM-dd'T'HH:mm:ss.SSSXXX", null)
        return zoneName == null ? s : f"{s}[{zoneName!}]"
    }
}
