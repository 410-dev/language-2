@using sdk 1

// io.Path: file system paths as text (spec 14.8). Separators follow the platform.

using intrinsics as intr

public class Path {
    public static function String join(&String a, &String b) {
        return intr.pathJoin([a.clone(), b.clone()])
    }

    public static function String join(&String a, &String b, &String c) {
        return intr.pathJoin([a.clone(), b.clone(), c.clone()])
    }

    public static function String join(&String[] parts) {
        return intr.pathJoin(parts)
    }

    // the containing directory; null for a root or a bare name
    public static function String? parent(&String path) {
        return intr.pathParent(path)
    }

    // "dir/report.txt" -> "report.txt"
    public static function String? fileName(&String path) {
        return intr.pathFileName(path)
    }

    // "dir/report.txt" -> "report"
    public static function String? stem(&String path) {
        return intr.pathStem(path)
    }

    // "dir/report.txt" -> "txt"
    public static function String? extension(&String path) {
        return intr.pathExtension(path)
    }

    // absolute, with "." and ".." resolved
    public static function String absolute(&String path) {
        return intr.pathAbsolute(path)
    }

    // "." and ".." resolved without touching the file system
    public static function String normalize(&String path) {
        return intr.pathNormalize(path)
    }

    public static function String separator() {
        return intr.pathSeparator()
    }

    public static function Boolean exists(&String path) {
        return intr.fsExists(path)
    }

    public static function Boolean isFile(&String path) {
        return intr.fsIsFile(path)
    }

    public static function Boolean isDirectory(&String path) {
        return intr.fsIsDir(path)
    }
}
