// A short tour of the language (see SPEC.md).
@using sdk 1
@runtime compiler interpreter bytecode
@compiler(
    Target=[i386, amd64, arm64]
    MemoryManagement=ownership
)
@runtimecfg(
    IntegerOverflow=error
)

using stdio as stdio

public interface Shape {
    public function Float64 area()

    public default function String describe() {
        return f"{this.name()} with area {this.area().format(-1, 2)}"
    }

    public function String name()
}

public class Circle implements Shape {
    private getter Float64 radius

    public Circle(Float64 radius) {
        this.radius = radius
    }

    public function Float64 area() {
        return 3.141592653589793 * radius ** 2
    }

    public function String name() {
        return "circle"
    }
}

public class Rect implements Shape {
    private Float64 w
    private Float64 h

    public Rect(Float64 w, Float64 h) {
        this.w = w
        this.h = h
    }

    public function Float64 area() {
        return w * h
    }

    public function String name() {
        return "rect"
    }
}

public class Logger implements Droppable {
    private String tag

    public Logger(String tag) {
        this.tag = tag
        stdio.println(f"[{this.tag}] start")
    }

    public function void drop() {
        stdio.println(f"[{tag}] end")
    }
}

function (Float64, Float64) minMax(&Shape[] shapes) {
    Float64 lo = Float64.MAX
    Float64 hi = Float64.MIN
    for (s in shapes) {
        Float64 a = s.area()
        lo = a < lo ? a : lo
        hi = a > hi ? a : hi
    }
    return lo, hi
}

function T firstOr[T](&T[] items, T fallback) {
    if (items.isEmpty()) {
        return fallback
    }
    return items.first().clone()
}

function void main() {
    Logger log = Logger("tour")

    Shape[] shapes = Shape.array()
    shapes.insert(0, Circle(1.0))
    shapes.insert(1, Rect(2.0, 3.5))
    for (s in shapes) {
        stdio.println(s.describe())
    }
    lo, hi = minMax(&shapes)
    stdio.println(f"min={lo.format(-1, 3)} max={hi.format(-1, 3)}")

    // ownership: moves, clones and references
    String a = "hello"
    String b = a.clone()
    b.append(", world")
    stdio.println(a + " / " + b)

    // nullable values
    String[] words = "red green blue".split(" ")
    String? none = null
    stdio.println(none ?? firstOr(&words, "none"))

    // dictionaries and dynamic values
    Dictionary[String, Int64] counts = {"red": 1}
    counts["blue"] = 2
    counts["red"] += 10
    stdio.println(counts)

    // checked arithmetic
    try {
        Int8 small = 120
        small += 10
    } catch (ArithmeticException e) {
        stdio.println("caught: " + e.getMessage())
    }

    // switch with explicit fallthrough
    switch (counts.length() as n) {
        case n == 2:
            stdio.println("two entries")
            fallthrough
        default:
            stdio.println("done")
    }
}
